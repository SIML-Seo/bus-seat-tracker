{
  "name": "bus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:debug": "set NODE_OPTIONS=--inspect && next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "next lint",
    "collect:bus": "tsx scripts/collectBusData.ts",
    "cleanup": "tsx scripts/cleanupStorage.ts",
    "db:status": "tsx -e \"const { prisma } = require('./lib/prisma/client'); async function main() { console.log('BusLocation:', await prisma.busLocation.count()); console.log('BusStopSeats:', await prisma.busStopSeats.count()); console.log('BusRoute:', await prisma.busRoute.count()); console.log('BusStop:', await prisma.busStop.count()); await prisma.$disconnect(); } main();\""
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "@supabase/supabase-js": "^2.49.1",
    "axios": "^1.7.9",
    "next": "15.1.11",
    "prisma": "^6.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "swr": "^2.3.2",
    "tsx": "^4.19.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.1.7",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
